nextflow.enable.dsl = 2

params {
    dataset = 'geo_pilot'
    samples = "${projectDir}/data/geo_pilot.csv"
    outdir = "${projectDir}/results"
    analysis_image = 'scrna-scatac:end2end'

    cellranger_image = ''
    ref_url = 'https://cf.10xgenomics.com/supp/cell-exp/refdata-gex-GRCh38-2024-A.tar.gz'
    fastq_url = 'https://cf.10xgenomics.com/samples/cell-exp/3.0.0/pbmc_1k_v3/pbmc_1k_v3_fastqs.tar'
    local_matrices = ''
    qc_min_genes = 200
    qc_max_mt = 25.0
    qc_max_genes = 9000
    target_cells = 12000
    run_scrublet = true
    use_scvi = false
    run_liana = false
    run_soupx = false
    run_infercnv = false
    n_pcs = 30
    leiden_resolution = 0.6
}

process {
    executor = 'local'
    cpus = 4
    memory = '16 GB'
    errorStrategy = 'terminate'
    maxRetries = 0
    withName: DOWNLOAD_GEO {
        cpus = 1
        memory = '2 GB'
    }
    withName: PREP_FASTQ {
        cpus = 2
        memory = '4 GB'
    }
    withName: CELLRANGER_COUNT {
        cpus = 8
        memory = '48 GB'
        container = params.cellranger_image
    }
    withName: ANALYZE {
        cpus = 8
        memory = '56 GB'
    }
    withName: EDGER {
        cpus = 4
        memory = '12 GB'
        container = params.edger_image
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.fixOwnership = true
    }
    local { docker.enabled = false }
}





cleanup = false
trace { enabled = true; file = "${params.outdir}/pipeline_trace.tsv"; overwrite = true }
report { enabled = true; file = "${params.outdir}/nextflow_execution_report.html"; overwrite = true }
timeline { enabled = true; file = "${params.outdir}/nextflow_timeline.html"; overwrite = true }


params.run_edger = false
params.edger_image = 'scrna-scatac-edger:end2end'
params.gene_annotation = "${projectDir}/assets/gencode.v44.basic.annotation.gtf.gz"
